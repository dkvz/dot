{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "cd*": "allow",
      "tail*": "allow",
      "head*": "allow",
      "wc*": "allow",
      "find*": "allow",
      "rg*": "allow",
      "fd*": "allow",
      "go build *": "allow",
      "go get *": "allow",
      "go mod *": "allow",
      "gofmt*": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
    }
  }
}
